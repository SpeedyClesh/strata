// Strata — Prisma schema
// PostgreSQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum CardBrand {
  VISA
  MASTERCARD
  AMEX
}

enum CardStatus {
  ACTIVE
  PENDING
  FROZEN
}

enum NotificationKind {
  INFO
  BALANCE
  SECURITY
  SUPPORT
}

enum SupportStatus {
  OPEN
  RESOLVED
}

enum SenderRole {
  USER
  ADMIN
}

enum TxnStatus {
  PROCESSED
  PENDING
  UNDER_REVIEW
}

enum CryptoAsset {
  BTC
  ETH
  USDT
}

enum LoanStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  CLOSED
}

enum LoanType {
  PERSONAL
  AUTOMOBILE
  BUSINESS
  MORTGAGE
  OVERDRAFT
  HEALTH
}

enum DepositStatus {
  PENDING
  PROCESSED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         Role      @default(USER)
  pinHash      String?
  phone        String?
  country      String?
  city         String?
  dob          DateTime?
  createdAt    DateTime  @default(now())

  accounts       Account[]
  notifications  Notification[]
  supportThreads SupportThread[]
  loans          Loan[]
  deposits       Deposit[]
}

model Account {
  id            String   @id @default(cuid())
  userId        String
  accountNumber String   @unique
  balance       Decimal  @default(0)
  currency      String   @default("USD")
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  outgoingTransactions Transaction[]   @relation("FromAccount")
  incomingTransactions Transaction[]   @relation("ToAccount")
  cards                Card[]
  cryptoBalances       CryptoBalance[]
}

model Transaction {
  id            String    @id @default(cuid())
  fromAccountId String
  toAccountId   String?
  amount        Decimal
  description   String
  status        TxnStatus @default(PROCESSED)
  createdAt     DateTime  @default(now())

  fromAccount Account  @relation("FromAccount", fields: [fromAccountId], references: [id], onDelete: Cascade)
  toAccount   Account? @relation("ToAccount", fields: [toAccountId], references: [id], onDelete: SetNull)

  @@index([fromAccountId])
  @@index([toAccountId])
}

model Card {
  id         String     @id @default(cuid())
  accountId  String
  brand      CardBrand  @default(VISA)
  last4      String
  numberFull String
  expMonth   Int
  expYear    Int
  cvv        String
  status     CardStatus @default(ACTIVE)
  balance    Decimal    @default(0)
  createdAt  DateTime   @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model CryptoBalance {
  id        String      @id @default(cuid())
  accountId String
  asset     CryptoAsset
  amount    Decimal     @default(0)
  usdRate   Decimal     @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, asset])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  kind      NotificationKind @default(INFO)
  title     String
  body      String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model SupportThread {
  id        String        @id @default(cuid())
  userId    String
  subject   String
  status    SupportStatus @default(OPEN)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  @@index([userId])
  @@index([status])
}

model SupportMessage {
  id         String     @id @default(cuid())
  threadId   String
  senderRole SenderRole
  body       String
  createdAt  DateTime   @default(now())

  thread SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
}

model Loan {
  id           String     @id @default(cuid())
  userId       String
  type         LoanType
  amount       Decimal
  termMonths   Int
  purpose      String
  status       LoanStatus @default(PENDING)
  interestRate Decimal    @default(5)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model Deposit {
  id        String        @id @default(cuid())
  userId    String
  amount    Decimal
  method    String
  status    DepositStatus @default(PROCESSED)
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
