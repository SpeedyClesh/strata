# PostgreSQL connection string.
# Local:   postgresql://USER:PASSWORD@localhost:5432/strata
# Vercel:  auto-injected when you create a Vercel Postgres or Neon database.
DATABASE_URL="postgresql://user:password@localhost:5432/strata"

# Generate with:  openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-string"

# Local dev: http://localhost:3000
# Production: your Vercel URL, e.g. https://strata-xxx.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# Optional. If set, admin messages and support replies are sent as real email
# via Resend (https://resend.com). If unset, they are logged to the server
# console instead. Everything else in the app works the same either way.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Strata <onboarding@resend.dev>"
